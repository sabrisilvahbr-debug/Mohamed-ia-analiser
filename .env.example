# ===================================================================
# AI OTC TRADER 3D — variáveis de ambiente
# Copie para ".env" (nunca envie o .env ao GitHub) ou configure no
# painel do provedor de hospedagem (Render, Oracle VM, etc.).
# ===================================================================

# Porta HTTP (o Render define automaticamente)
PORT=8080

# Senha do PAINEL (não é a senha da Deriv). Mínimo 16 caracteres.
# Gere uma aleatória, por exemplo: openssl rand -hex 24
ADMIN_TOKEN=

# Caminho do banco SQLite (use um disco persistente em produção)
DB_PATH=./data/trader.db

# ------------------- Deriv (https://developers.deriv.com) -----------
# Sem DERIV_APP_ID e DERIV_PAT o sistema usa somente o canal PÚBLICO:
# cotações reais, sem saldo e sem ordens.
#
# App ID registrado no painel de desenvolvedor da Deriv
DERIV_APP_ID=
# Personal Access Token (PAT) com escopo "trade". Gere no painel da Deriv.
DERIV_PAT=
# OPCIONAL. Vazio = o sistema descobre sozinho a conta DEMO (GET /accounts).
DERIV_ACCOUNT_ID=

# Base da API (documentação oficial)
DERIV_REST_BASE=https://api.derivws.com
DERIV_PUBLIC_WS=wss://api.derivws.com/trading/v1/options/ws/public

# Origens externas autorizadas a usar a API (painel no Cloudflare Pages).
# Separe várias com vírgula. Vazio = só o próprio servidor.
ALLOWED_ORIGINS=

# ------------------- Segurança da execução --------------------------
# Execução em conta REAL fica BLOQUEADA a menos que isto seja "true".
# Mesmo assim o painel exige confirmação explícita.
ALLOW_REAL_TRADING=false
