{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "backend/src/**/*.ts",
    "backend/test/**/*.ts",
    "scripts/**/*.ts",
    "cloudflare/src/**/*.ts"
  ]
}
